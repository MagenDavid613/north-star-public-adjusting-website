# ─── AI CHAT (server-only) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── GHL / LEAD ROUTING (server-only) ────────────────────────────────────────
# GHL Premium Inbound Webhook URL. Chatbot leads post here with source:
# "chatbot"; a future Retell voice agent should post here too with
# source: "voice_agent".
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/XXXXXXXXXXXX/webhook-trigger/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# ─── RETELL (not yet wired) ───────────────────────────────────────────────────
# RETELL_API_KEY=
# NEXT_PUBLIC_RETELL_AGENT_ID=

# ─── LEADS SHEET (server-only) ────────────────────────────────────────────────
# "Northstar Public Adjusting — Client Leads" Google Sheet. Written to by
# src/lib/leads-sheet.ts from the web form, the chatbot close handler, and
# the Retell webhook. Uses a service account (Google Cloud Console > IAM &
# Admin > Service Accounts > Keys > Create new key, JSON), shared as Editor
# on the sheet itself.
LEADS_SHEET_ID=1TEBmOWhrklMOXW4kB5YlgRxeohAKq4bC_BbUeq6Uxyc
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxxx@xxxxx.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON as-is (keep the \n escapes).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# ─── SITE ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://northstarpublicadjusting.com
