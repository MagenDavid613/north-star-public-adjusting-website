# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Phone Number SIDs (PNxxxxxxxx...) — find these in Twilio Console > Phone Numbers > Manage > Active Numbers,
# click each number, the SID is in the URL / on the page.
MAIN_NUMBER_SID=PNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx        # the 866 number
DAVID_DIRECT_SID=PNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx       # David's direct 786 line, IF it is its own Twilio number/DID
ADJUSTER_DIRECT_SID=PNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx    # the adjuster's direct line, IF it is its own Twilio number/DID

# The 866 number in E.164, used by the Retell transfer_call tool ("press 1" / "transfer me")
MAIN_NUMBER_E164=+18667827577

# ---- Humans to ring ----
DAVID_CELL=+1XXXXXXXXXX
ADJUSTER_CELL=+1XXXXXXXXXX

# How long (seconds) to ring a human leg before it's considered "no answer"
RING_TIMEOUT_SECONDS=20

# ---- Fallback: where to send the call when nobody picks up ----
# This MUST be whatever Retell already has wired to the 866 number today (the thing that
# currently answers every call with "Sara"). Find it in Retell Dashboard > Phone Numbers >
# Northstar 866 > "..." > Edit Phone Number Settings — it will be either a SIP URI
# (sip:something@sip.retellai.com) or a plain number. Copy it here verbatim.
RETELL_FALLBACK_DESTINATION=sip:REPLACE_ME@sip.retellai.com

# ---- Public URL of this app (Twilio must be able to reach it over HTTPS) ----
# In local dev this is your ngrok URL, e.g. https://abcd1234.ngrok-free.app
# In production this is your deployed URL (Render/Railway/Fly/etc.)
PUBLIC_BASE_URL=https://your-app-url.example.com

PORT=3000

# ---- Retell ----
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxx
# The LLM id backing the "Northstar Public Adjusting" agent (NOT the agent id).
# Get it with: GET https://api.retellai.com/get-agent/{agent_id}  -> response.response_engine.llm_id
RETELL_LLM_ID=llm_xxxxxxxxxxxxxxxxxxxxxxxx
